<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/utubot_overlay_focus" />
            <corners android:radius="@dimen/utubot_overlay_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/utubot_overlay_focus_soft" />
            <corners android:radius="@dimen/utubot_overlay_corner" />
        </shape>
    </item>
</selector>
