<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- A literal label next to the icon from main: the system installer's "App installed" screen and some launchers read the
         label of a package file without resolving its resources, and then show the application class name. Keep it the same as
         app_name in src/stutubot/res/values/strings.xml (UtubotAppHooksTest checks). -->
    <application
        android:label="u·tubot"
        tools:replace="android:label">
        <!-- The film screen of the Real-Debrid spike; reached from Settings, Updates, "Films (developer)", closes itself when that is off -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.utubot.films.RealDebridFilmsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>

</manifest>
